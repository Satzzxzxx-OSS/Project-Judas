JudasScene 3
settings
  name "Camera surfaces"
  world-origin 0 0 0
  sun-direction .4 .7 .35
  sun-color .35 .35 .35
  ambient .8 .8 .8
  fluid-scale 1
  fidelity-policy none
  next-id 21
end

object 1 "Moving red subject"
  position 4 0.5 -5
  rotation 1 0 0 0
  scale 1 1 1
  render box
  render.color 0.92 0.13 0.06
  render.half-extents .5 .5 .5
  body dynamic box
  body.half-extents .5 .5 .5
  body.friction 0
  body.restitution 1
  body.mass 1
  body.initial-velocity .8 0 0
  body.pickable true
  render.radius .5
  render.alpha 1
  render.secondary-color .8 .8 .8
  render.secondary-alpha 1
  render.mesh-asset ""
  render.texture-asset ""
  body.radius .5
  body.terrain ""
  body.managed false
  body.compound-count 0
end

object 2 "Green sphere"
  position 6 0.85 -5
  rotation 1 0 0 0
  scale 1 1 1
