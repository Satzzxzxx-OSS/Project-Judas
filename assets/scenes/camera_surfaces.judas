  render.secondary-color .8 .8 .8
  render.secondary-alpha 1
  render.mesh-asset ""
  render.texture-asset ""
end

object 3 "Stage camera"
  position 5 1.5 -1
  rotation 1 0 0 0
  scale 1 1 1
  render-camera
  camera.enabled true
  camera.width 640
  camera.height 360
  camera.cadence 1
  camera.fov 55
  camera.near .1
  camera.far 50
end

