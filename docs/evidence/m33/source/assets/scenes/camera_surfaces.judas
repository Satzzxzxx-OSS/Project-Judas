JudasScene 3
settings
  name "Camera surfaces"
  world-origin 0 0 0
  sun-direction 0.4 0.7 0.35
  sun-color 0 0 0
  ambient 1 1 1
  fluid-scale 1
  fluid-update-rate-hz 30
  fluid-hydrostatic-drag-rate 2
  fidelity-policy none
  next-id 7
end

object 1 "Moving subject"
  position -1 1 0
  rotation 1 0 0 0
  scale 1 1 1
  render box
  render.half-extents 0.5 0.5 0.5
  render.radius 0.5
  render.color 1 0.05 0.02
  render.alpha 1
  render.secondary-color 0.8 0.8 0.8
  render.secondary-alpha 1
  render.mesh-asset ""
  render.texture-asset ""
  body dynamic box
  body.half-extents 0.5 0.5 0.5
  body.radius 0.5
  body.terrain ""
  body.mass 1
  body.friction 0.6
  body.restitution 0.1
  body.initial-velocity 0.15 0 0
  body.pickable true
  body.managed false
  body.compound-count 0
  body.fluid-cavity-count 0
end

object 2 "Other subject"
  position 1 1 0
  rotation 1 0 0 0
  scale 1 1 1
  render box
  render.half-extents 0.5 0.5 0.5
  render.radius 0.5
  render.color 0.02 1 0.05
  render.alpha 1
  render.secondary-color 0.8 0.8 0.8
  render.secondary-alpha 1
  render.mesh-asset ""
  render.texture-asset ""
end

object 3 "West view"
  position -1 1 4
  rotation 1 0 0 0
  scale 1 1 1
  render-camera 
  camera.enabled true
  camera.width 128
  camera.height 96
  camera.cadence 1
  camera.fov 60
  camera.near 0.1
  camera.far 50
end

object 4 "East view"
  position 1 1 4
  rotation 1 0 0 0
  scale 1 1 1
  render-camera 
  camera.enabled true
  camera.width 128
  camera.height 96
  camera.cadence 1
  camera.fov 60
  camera.near 0.1
  camera.far 50
end

object 5 "Display surface"
  position 0 1 2
  rotation 1 0 0 0
  scale 1 1 1
  render box
  render.half-extents 0.7 0.45 0.025
  render.radius 0.5
  render.color 1 1 1
  render.alpha 1
  render.secondary-color 0.8 0.8 0.8
  render.secondary-alpha 1
  render.mesh-asset ""
  render.texture-asset ""
  render.texture-camera 3
end

object 6 "Player start"
  position 0 1 6
  rotation 1 0 0 0
  scale 1 1 1
  player-start first-person
  player-start.yaw 0
  player-start.density 950
  player-start.fluid-drag 2
  player-start.swim-acceleration 4
end
